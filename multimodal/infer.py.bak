
import math
import numpy as np
import torch
import torchvision.transforms as T
from PIL import Image
from torchvision.transforms.functional import InterpolationMode
from transformers import AutoModel, AutoTokenizer, BitsAndBytesConfig, TextIteratorStreamer
from fastapi import FastAPI, UploadFile, File, Form
from fastapi.responses import StreamingResponse
import io
from threading import Thread
import uvicorn
import logging

# 配置日志，方便调试
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# 初始化FastAPI应用
app = FastAPI(title="InternVL3 API服务")

# 模型和图像处理相关设置
IMAGENET_MEAN = (0.485, 0.456, 0.406)
IMAGENET_STD = (0.229, 0.224, 0.225)

def build_transform(input_size):
    MEAN, STD = IMAGENET_MEAN, IMAGENET_STD
    transform = T.Compose([
        T.Lambda(lambda img: img.convert('RGB') if img.mode != 'RGB' else img),
        T.Resize((input_size, input_size), interpolation=InterpolationMode.BICUBIC),
        T.ToTensor(),
        T.Normalize(mean=MEAN, std=STD)
    ])
    return transform

def find_closest_aspect_ratio(aspect_ratio, target_ratios, width, height, image_size):
    best_ratio_diff = float('inf')
    best_ratio = (1, 1)
    area = width * height
    for ratio in target_ratios:
        target_aspect_ratio = ratio[0] / ratio[1]
        ratio_diff = abs(aspect_ratio - target_aspect_ratio)
        if ratio_diff < best_ratio_diff:
            best_ratio_diff = ratio_diff
            best_ratio = ratio
        elif ratio_diff == best_ratio_diff:
            if area > 0.5 * image_size * image_size * ratio[0] * ratio[1]:
                best_ratio = ratio
    return best_ratio

def dynamic_preprocess(image, min_num=1, max_num=12, image_size=448, use_thumbnail=False):
    orig_width, orig_height = image.size
    aspect_ratio = orig_width / orig_height

    target_ratios = set(
        (i, j) for n in range(min_num, max_num + 1) for i in range(1, n + 1) for j in range(1, n + 1) if
        i * j <= max_num and i * j >= min_num)
    target_ratios = sorted(target_ratios, key=lambda x: x[0] * x[1])

    target_aspect_ratio = find_closest_aspect_ratio(
        aspect_ratio, target_ratios, orig_width, orig_height, image_size)

    target_width = image_size * target_aspect_ratio[0]
    target_height = image_size * target_aspect_ratio[1]
    blocks = target_aspect_ratio[0] * target_aspect_ratio[1]

    resized_img = image.resize((target_width, target_height))
    processed_images = []
    for i in range(blocks):
        box = (
            (i % (target_width // image_size)) * image_size,
            (i // (target_width // image_size)) * image_size,
            ((i % (target_width // image_size)) + 1) * image_size,
            ((i // (target_width // image_size)) + 1) * image_size
        )
        split_img = resized_img.crop(box)
        processed_images.append(split_img)
    assert len(processed_images) == blocks
    if use_thumbnail and len(processed_images) != 1:
        thumbnail_img = image.resize((image_size, image_size))
        processed_images.append(thumbnail_img)
    return processed_images

def load_image_from_bytes(image_bytes, input_size=448, max_num=12):
    """从字节数据加载并处理图像"""
    try:
        image = Image.open(io.BytesIO(image_bytes)).convert('RGB')
        transform = build_transform(input_size=input_size)
        images = dynamic_preprocess(image, image_size=input_size, use_thumbnail=True, max_num=max_num)
        pixel_values = [transform(image) for image in images]
        pixel_values = torch.stack(pixel_values)
        logger.info(f"图像处理完成，生成 {len(pixel_values)} 个tile")
        return pixel_values
    except Exception as e:
        logger.error(f"图像处理失败: {str(e)}", exc_info=True)
        raise

# 加载模型和分词器
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_use_double_quant=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_compute_dtype=torch.bfloat16
)

# 模型路径，请根据实际情况修改
path = "/home/ubuntu/.cache/modelscope/hub/models/OpenGVLab/InternVL3_5-8B/" 
try:
    logger.info("开始加载模型...")
    model = AutoModel.from_pretrained(
        path,
        dtype=torch.bfloat16,
        quantization_config=bnb_config,
        low_cpu_mem_usage=True,
        use_flash_attn=True,
        local_files_only=True,
        trust_remote_code=True).eval()
    tokenizer = AutoTokenizer.from_pretrained(path, trust_remote_code=True, use_fast=False)
    tokenizer.pad_token = tokenizer.eos_token
    logger.info("模型加载完成")
except Exception as e:
    logger.error(f"模型加载失败: {str(e)}", exc_info=True)
    raise

# 全局历史记录存储（生产环境建议用Redis）
history_store = {}

# 生成配置（关闭do_sample可提高速度，方便调试）
generation_config = dict(max_new_tokens=1024, do_sample=False)

# -------------------------- 修复1：修改generate_response，用容器传递历史 --------------------------
def generate_response(question, pixel_values, history, result_container):
    """
    生成响应的生成器函数
    - result_container: 字典，用于传递new_history和错误信息（避免依赖生成器return）
    """
    streamer = TextIteratorStreamer(
        tokenizer, 
        skip_prompt=True, 
        skip_special_tokens=True, 
        timeout=30
    )
    
    gen_config = generation_config.copy()
    gen_config["streamer"] = streamer
    
    def chat_task():
        try:
            logger.info(f"开始生成响应，问题: {question[:50]}...")
            # 确保history为列表格式（InternVL3要求history是[[问1,答1], [问2,答2]]）
            input_history = history if (history is not None and isinstance(history, list)) else []
            logger.info(f"传入的历史记录: {input_history}")  # 调试：打印传入的历史
            
            # 调用模型（return_history=True必须保留）
            response, new_history = model.chat(
                tokenizer=tokenizer,
                pixel_values=pixel_values,
                question=question,
                history=input_history,
                return_history=True,
                generation_config=gen_config
            )
            
            # 显式存入容器（关键：替代生成器return）
            result_container["new_history"] = new_history
            result_container["success"] = True
            logger.info(f"生成的新历史: {new_history}")  # 调试：打印新历史
            logger.info("响应生成完成")
        except Exception as e:
            error_msg = f"模型调用失败: {str(e)}"
            logger.error(error_msg, exc_info=True)
            result_container["error"] = error_msg
            result_container["new_history"] = history  # 错误时保留原历史
            result_container["success"] = False
    
    # 启动子线程
    thread = Thread(target=chat_task)
    thread.start()
    
    # 流式输出响应
    try:
        for new_text in streamer:
            # 避免sep字符干扰（不同模型sep可能不同，可打印model.conv_template查看）
            if hasattr(model, 'conv_template') and new_text == model.conv_template.sep:
                break
            yield new_text
        # 输出错误信息（若有）
        if "error" in result_container:
            yield f"\n⚠️  错误: {result_container['error']}"
    except Exception as e:
        error_msg = f"流式输出失败: {str(e)}"
        logger.error(error_msg)
        yield f"\n⚠️  错误: {error_msg}"
    
    # 等待子线程结束
    thread.join()

# -------------------------- 修复2：修改/chat接口，用容器接收历史 --------------------------
@app.post("/chat")
async def chat(
    question: str = Form(...),
    session_id: str = Form("default"),
    image: UploadFile = File(None),
    image1: UploadFile = File(None),
):
    """与模型聊天的API端点（支持多轮对话）"""
    # 1. 获取会话历史（首次为None，后续为列表）
    #history = history_store.get(session_id, None)
    history = None
    if history is None:
        logger.info(f"会话 {session_id} - 无历史记录")
    else:
        logger.info(f"会话 {session_id} - 读取到历史: {history}")
    
    logger.info(f"收到会话 {session_id} 的请求，问题: {question[:50]}...")
    
    # 2. 处理图像
    pixel_values = None
    if image:
        try:
            image_bytes = await image.read()
            pixel_values = load_image_from_bytes(image_bytes).to(torch.bfloat16).cuda()
            if image1:
                image1_bytes = await image1.read()
                pixel_values1 = load_image_from_bytes(image1_bytes).to(torch.bfloat16).cuda()
                pixel_values = torch.cat((pixel_values1,pixel_values),dim=0)
            else:
                print('加载image1失败')
            question = f'<image>\n{question}.'  # 拼接图像标记
            logger.info(f"已接收图像: {image.filename}")
        except Exception as e:
            error_msg = f"图像加载失败: {str(e)}"
            logger.error(error_msg)
            return {"error": error_msg}
    
    # 3. 用字典存储结果（关键：显式传递new_history，避免生成器return的坑）
    result_container = {}
    
    # 4. 定义最终的响应生成器（只调用1次generate_response）
    def final_response_generator():
        # 调用生成器，流式输出响应
        yield from generate_response(question, pixel_values, history, result_container)
        # 响应生成完成后，更新历史记录（核心修复点）
        # if result_container.get("success", False) and "new_history" in result_container:
        #     history_store[session_id] = result_container["new_history"]
        #     logger.info(f"会话 {session_id} - 已存储历史: {history_store[session_id]}")
        # else:
        #     logger.warning(f"会话 {session_id} - 历史未更新（可能是调用失败）")
    
    # 5. 返回流式响应
    return StreamingResponse(final_response_generator(), media_type="text/plain")

@app.delete("/history/{session_id}")
async def clear_history(session_id: str):
    """清除指定会话的历史记录"""
    if session_id in history_store:
        del history_store[session_id]
        logger.info(f"清除会话 {session_id} 的历史记录")
        return {"message": f"会话 {session_id} 的历史已清除"}
    return {"message": f"会话 {session_id} 不存在"}

if __name__ == "__main__":
    # 启动服务器（workers=1必须保留，多worker会导致内存不共享）
    uvicorn.run(app, host="0.0.0.0", port=6888, workers=1, log_level="info")